# Askervein in a conventionally neutral boundary layer, to steady with the
# SIMPLEC stage: the neutral deck (inputs_steady_askervein) with
# the potential temperature, gravity, Coriolis and the sounding of the flat
# and hill cases kept. The neutral deck stays for the ERF
# comparison (ERF's Askervein deck is neutral without Coriolis).
#   * Mesh: 30 x 30 x 26 cells over 6 km x 6 km, Askervein's 20 m first layer
#     stretched by 1.08, now to 1599 m (the neutral deck stops at 749 m, below
#     the inversion), the terrain of extern_erf/askervein.txt (command line).
#   * Sounding: 300 K to 700 m, 309 K at 1000 m, 0.03 K/m above (the flat and
#     hill cases), the same gradient held at the slip top.
#   * Coriolis at 57.2 N (Earth's sidereal day, f = 1.226e-4 1/s, horizontal
#     terms) with the geostrophic wind of the precursor
#     (inputs_precursor_askervein_cnbl): turned so the 10 m inflow wind blows
#     along +x, its speed set for u* = 0.6 m/s, the neutral deck's inflow.
#   * Inflow: the precursor's steady planar means (z u v theta k,
#     Tests/Real_Terrain/Askervein_CNBL/askervein_cnbl_inflow.txt given on the command line as
#     bc.inflow_file, tools/make_inflow_table.py). The
#     wind turns to -y with height (Ekman veer, v < 0 at every level), so the
#     flow enters through xlo and yhi and leaves through xhi and ylo.
#   * Rayleigh damping of w and theta towards the inflow profile above 1200 m
#     (0.2 1/s), as the hill cases, for the gravity waves the hill launches on
#     the stratified layer.
#   * Steady: the drop criterion of 2 orders of the flat case (the capped layer
#     entrains the inversion without end, inputs_steady_neutral_flat), four
#     z-line sweeps at a CFL cap of 2 (the stratified setting of the flat case).
# The first guess is the mass-consistent field of the inflow profile.
mesh.n_cell        = 30 30 26
mesh.prob_lo       = -3000. -3000. 0.
mesh.prob_hi       =  3000.  3000. 1600.
mesh.max_grid_size = 16
mesh.dz0           = 20.
mesh.stretch_ratio = 1.08

terrain.type      = erf_grid
terrain.smoothing = 0

bc.xlo = inflow
bc.xhi = outflow
bc.ylo = outflow
bc.yhi = inflow
bc.zlo = surface_layer
bc.zhi = slip_wall
bc.surface_z0      = 0.03
bc.inflow_profile  = file
bc.theta_profile_z = 0. 700. 1000. 1600.
bc.theta_profile   = 300. 300. 309. 327.
bc.zhi_theta_grad  = 0.03
bc.rayleigh_zdamp    = 1200.
bc.rayleigh_dampcoef = 0.2
bc.rayleigh_fields   = w theta

init.first_guess = profile
init.alpha_h     = 1.0
init.alpha_v     = 0.5

solver.poisson_reltol   = 1.e-10
solver.poisson_max_iter = 200
# solver.poisson_precond: not set; init.alpha_v != init.alpha_h, so the projection uses gmres_fft with its default FFT preconditioner (the SIMPLEC stage keeps the default gmres_mlmg).

forcing.coriolis        = 1
forcing.coriolis_3d     = 0
forcing.latitude        = 57.2
forcing.rotation_period = 86164.0905
forcing.geostrophic     = 1
forcing.ug              = 17.028798
forcing.vg              = -7.380863

turb.tke_floor = 1.e-6

steady.stage                   = simplec
steady.sweep                   = zjacobi   # z-line Jacobi sweep (the CPU default is lusgs)
steady.cfl0                    = 1.
steady.cfl_max                 = 2.
steady.zline_sweeps            = 4
steady.residual_ref_iterations = 100
steady.residual_drop_orders    = 2
steady.max_iterations          = 20000

io.plot_file      = steady_askervein_cnbl_plt
io.turb_plot_file = steady_askervein_cnbl_turb
io.chk_file       = steady_askervein_cnbl_chk
