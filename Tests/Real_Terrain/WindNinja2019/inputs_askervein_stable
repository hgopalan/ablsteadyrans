# Wagenbrenner et al. (2019) comparison, Askervein, slightly stable (the measurements were taken in slightly
# stable air; the paper's COM run used WindNinja's slightly stable setting): inputs_askervein with buoyancy and
# theta = 300 K at the ground rising 0.003 K/m to the top (bulk Richardson number about 0.06 between 10 m and
# 100 m), the same gradient through the top and theta damped with w from 600 m, so the case has a steady
# state (a heat input through the top with no way out would have none).
# Otherwise as inputs_askervein: 8.9 m/s from 210 degrees at 10 m
# (towards 60 degrees counter-clockwise from x), lines A, AA and B. Terrain:
# extern_erf/askervein.txt (terrain.file on the command line). 256 x 256 x 64 cells over
# 6 km x 6 km (23.4 m, the terrain file's spacing; the paper's CFD had 20 m), a 1 m first
# layer stretched by 1.065 to 850 m (the Askervein study's mesh); the log law with
# z0 = 0.03 m and u* giving 8.9 m/s at 10 m through xlo and ylo.
mesh.n_cell           = 256 256 64
mesh.prob_lo          = -3000. -3000. 0.
mesh.prob_hi          =  3000.  3000. 850.5
mesh.max_grid_size    = 64
mesh.dz0              = 1.
mesh.stretch_ratio    = 1.065
mesh.hierarchy_levels = 3

terrain.type      = erf_grid
terrain.smoothing = 0

bc.xlo = inflow
bc.ylo = inflow
bc.xhi = outflow
bc.yhi = outflow
bc.zlo = surface_layer
bc.zhi = slip_wall
bc.surface_z0       = 0.03
bc.inflow_profile   = log_law
bc.inflow_ustar     = 0.6278
bc.inflow_z0        = 0.03
bc.inflow_direction = 60.
bc.theta_profile_z  = 0.   850.5
bc.theta_profile    = 300. 302.5515
bc.zhi_theta_grad   = 0.003
bc.rayleigh_zdamp    = 600.
bc.rayleigh_dampcoef = 0.2
bc.rayleigh_fields   = w theta

init.first_guess = profile
init.alpha_h     = 1.0
init.alpha_v     = 0.5

solver.poisson_reltol   = 1.e-10
solver.poisson_max_iter = 200

turb.tke_floor   = 1.e-6
simplec.w_vnn_cap = 16

steady.stage          = simplec
steady.sweep          = lusgs
steady.zline_sweeps   = 2
steady.cfl_max        = 16
steady.sequencing     = 1
steady.max_iterations = 20000

io.plot_file        = plt
io.turb_plot_file   = turb
io.chk_file         = chk
io.write_checkpoint = 0
