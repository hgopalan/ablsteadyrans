# RT-1.15.2: ERF's Neutral_ABL_Flat (Exec/CanonicalTests/Canonical_RANS/
# Neutral_ABL_Flat/inputs_neutral) to steady with the SIMPLEC stage: 8 x 8 x 64
# cells on 2560 m x 2560 m x 1000 m (dz = 15.625 m), periodic sides, the
# surface layer on the ground (z0 = 0.1 m), a slip top with ERF's 0.03 K/m
# theta gradient above the sounding's inversion (300 K to 700 m, 309 K at
# 1000 m), the geostrophic wind (10, 0) m/s at latitude 90 with f = 1e-4 1/s
# (rotation period 4 pi / f), the horizontal Coriolis terms only
# (erf.coriolis_3d = false), the k-L closure with ERF's defaults (geometric
# length capped at 30 m). ERF integrates 12 h; the stage iterates to steady.
# The first guess is the log law with u* = 0.35 m/s along x, made
# divergence-free. Four z-line sweeps and a CFL cap of 2 (at 4 the
# stratified k-theta-w system and the SER ramp fall into bursts; the
# point-implicit buoyancy and rotation of the predictor keep the inversion
# and the free atmosphere damped); the residual reference is taken over the
# first 100 iterations (k adjusts from the log-law equilibrium to the capped
# length first). The capped boundary layer entrains the inversion and warms
# at 1.4e-7 K/s (0.012 K/day) without end, so theta and w carry a residual
# floor 2.4-2.6 orders below their reference while every residual is below
# steady.residual_tol: the drop criterion is set to 2 orders. A k floor of
# 1e-6 keeps round-off at the machine-epsilon floor from deciding the path
# (docs/solver.rst). ERF's check_neutral.py --physics reads
# io.turb_plot_file (Tests/Canonical_RANS/Neutral_ABL_Flat/check_steady_neutral.py).
mesh.n_cell        = 8 8 64
mesh.prob_hi       = 2560. 2560. 1000.
mesh.is_periodic   = 1 1 0
mesh.max_grid_size = 4 4

terrain.type = flat

bc.zlo = surface_layer
bc.zhi = slip_wall
bc.surface_z0 = 0.1
bc.theta_profile_z = 0. 700. 1000.
bc.theta_profile   = 300. 300. 309.
bc.zhi_theta_grad  = 0.03
bc.inflow_profile   = log_law
bc.inflow_ustar     = 0.35
bc.inflow_z0        = 0.1
# The first guess's k with the wall-law length (the form before bc.inflow_tke_length):
# with the closure's capped length the start-up transient is smaller, so the
# reference residuals are, and the entrainment floor of theta and w at the
# inversion (see above) no longer sits two orders below them; the run is then
# steady in its monitors but not by the drop criterion.
bc.inflow_tke_length = unbounded
bc.inflow_direction = 0.

init.first_guess = profile

forcing.coriolis        = 1
forcing.coriolis_3d     = 0
forcing.latitude        = 90.
forcing.rotation_period = 125663.7061435917
forcing.geostrophic     = 1
forcing.ug              = 10.
forcing.vg              = 0.

steady.stage                   = simplec
steady.sweep                   = zjacobi   # Phase 1 sweep (the CPU default is lusgs since sub-phase 2.6)
steady.cfl0                    = 1.
steady.cfl_max                 = 2.
steady.zline_sweeps            = 4
steady.residual_ref_iterations = 100
steady.residual_drop_orders    = 2

turb.tke_floor = 1.e-6
steady.max_iterations          = 20000

io.plot_file      = steady_neutral_flat_plt
io.turb_plot_file = steady_neutral_flat_turb
io.chk_file       = steady_neutral_flat_chk
