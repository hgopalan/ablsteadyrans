# RT-1.8.1: boundary fluxes of a fixed log-law state on ERF's Neutral_ABL_Flat
# mesh (Exec/CanonicalTests/Canonical_RANS/Neutral_ABL_Flat/inputs_neutral):
# 8 x 8 x 64 cells on 2560 m x 2560 m x 1000 m (dz = 15.625 m), periodic
# sides, the surface layer on the ground (z0 = 0.1 m) and a slip top with
# ERF's 0.03 K/m theta gradient above the sounding's inversion (300 K to
# 700 m, 309 K at 1000 m). Tests/Supporting_Files/Tools/boundary_fluxes.cpp.
mesh.n_cell        = 8 8 64
mesh.prob_hi       = 2560. 2560. 1000.
mesh.is_periodic   = 1 1 0
mesh.max_grid_size = 4 4

terrain.type = flat

bc.zlo = surface_layer
bc.zhi = slip_wall
bc.surface_z0 = 0.1
bc.theta_profile_z = 0. 700. 1000.
bc.theta_profile   = 300. 300. 309.
bc.zhi_theta_grad  = 0.03

fixed_state.ustar     = 0.35
fixed_state.z0        = 0.1
fixed_state.direction = 15.

io.plot_file = bc_neutral_flat_plt
