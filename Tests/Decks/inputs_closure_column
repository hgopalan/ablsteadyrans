# RT-1.9.1: the full residual of the wall law's equilibrium state with the k-L
# closure on ERF's Neutral_ABL_Flat mesh (8 x 8 x 64 cells, 2560 m x 2560 m x
# 1000 m, dz = 15.625 m), periodic sides, the surface layer on the ground
# (z0 = 0.1 m), a slip top, neutral (theta = 300 K). The state is the log law
# u = (u*/kappa) ln((z + z0)/z0) and k = u*^2/Cmu0^2; with the uncapped
# geometric length (max_geom_lscale far above the domain) and the logarithmic
# face mean, nu_t = kappa u* (z + z0), every interior momentum flux is u*^2 and
# production balances dissipation up to the discrete strain rate.
# Tests/Tools/closure_column.cpp, Tests/check_closure.py.
mesh.n_cell        = 8 8 64
mesh.prob_hi       = 2560. 2560. 1000.
mesh.is_periodic   = 1 1 0
mesh.max_grid_size = 4 4

terrain.type = flat

bc.zlo = surface_layer
bc.zhi = slip_wall
bc.surface_z0 = 0.1
bc.theta_profile_z = 0.
bc.theta_profile   = 300.

turb.max_geom_lscale = 1.0e12
turb.face_mean       = logarithmic

fixed_state.ustar     = 0.35
fixed_state.direction = 15.

io.plot_file = closure_column_plt
