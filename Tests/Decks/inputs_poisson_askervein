# RT-1.10.1: projection of a fixed wind on ERF's Askervein terrain with the
# Poisson layer (Tests/Tools/poisson_projection.cpp). ERF's Askervein mesh
# (Real_Terrain/Askervein/inputs_anel) coarsened to 30 x 30 cells of 200 m,
# 18 layers from 20 m growing by 1.08, basic terrain following.
# terrain.file is given on the command line (extern_erf/askervein.txt).
mesh.n_cell        = 30 30 18
mesh.prob_lo       = -3000. -3000. 0.
mesh.prob_hi       =  3000.  3000. 440.
mesh.max_grid_size = 16
mesh.dz0           = 20.
mesh.stretch_ratio = 1.08

terrain.type      = erf_grid
terrain.smoothing = 0

solver.poisson_reltol   = 1.e-10
solver.poisson_max_iter = 200
solver.poisson_precond  = fft

io.plot_file = poisson_askervein_plt
